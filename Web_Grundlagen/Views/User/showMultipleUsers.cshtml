@model IEnumerable<Web_Grundlagen.Models.User> 

@{
    ViewData["Title"] = "showMultipleUsers";
}

<h1>showMultipleUsers</h1>

<select id="roles">
</select>

  <form>
    <label for="radioMale">Geschlecht:</label>
    <input type="radio" id="radioMale" name="gender" value="male">
    <label for="radioFemale">Männlich</label>
    <input type="radio" id="radioFemale" name="gender" value="female">
    <label for="radioOther">Weiblich</label>
    <input type="radio" id="radioOther" name="gender" value="other">
    <br><br>
  </form>
  
  <!-- Checkbox -->
  <form>
    <label for="checkBox">Hobbies:</label>
    <input type="checkbox" id="checkBox1" name="hobby1" value="football">
    <label for="checkBox1">Fußball</label>
    <input type="checkbox" id="checkBox2" name="hobby2" value="music">
    <label for="checkBox2">Musik</label>
    <input type="checkbox" id="checkBox3" name="hobby3" value="reading">
    <label for="checkBox3">Lesen</label>
    <br><br>
  </form>

<table>
    <thead class="HeaderLevel1">
        <tr> 
            <th>Name</th>
            <th>Mail-Adresse</th>
            <th>Geburtsdatum</th>
        </tr>
    </thead>

    <tbody>

    </tbody>

    <tfoot>
        <tr> 
            <td colspan="4"></td>
        </tr>
    </tfoot>
</table>


